{
  "name": "nusa-rasa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi berbagi resep Nusantara berdasarkan desain Figma Atilla Kuncoro Djati.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "db:setup": "node --env-file-if-exists=.env server/setup.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
